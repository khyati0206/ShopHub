PORT=5000
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/shophub
MONGODB_DB_NAME=shophub
JWT_SECRET=your_jwt_secret_change_in_production
GEMINI_API_KEY=your_gemini_api_key
CLIENT_URL=http://localhost:5173
# Comma-separated extra frontend URLs (optional)
# CLIENT_URLS=https://shophub.vercel.app,https://shophub-git-main-username.vercel.app

# Vercel (frontend): set these in Project Settings → Environment Variables
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/shophub
# CLIENT_URL=https://your-app.vercel.app
# JWT_SECRET=long_random_secret
# GEMINI_API_KEY=your_gemini_api_key

# Render (backend): set these in Render Dashboard → Environment
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/shophub
# CLIENT_URL=https://your-app.vercel.app
# GEMINI_API_KEY=your_gemini_api_key
# JWT_SECRET is auto-generated by render.yaml (or set manually)
# MongoDB Atlas → Network Access → allow 0.0.0.0/0 so Render can connect
